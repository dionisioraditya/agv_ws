<?xml version="1.0" ?>
<robot name="agv_origin" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find agv_origin_description)/urdf/materials.xacro" />
<xacro:include filename="$(find agv_origin_description)/urdf/agv_origin.trans" />
<xacro:include filename="$(find agv_origin_description)/urdf/agv_origin.gazebo" />
<link name="base_footprint"/>

<joint name="base_footprint_joint" type="fixed">
  <parent link="base_footprint"/>
  <child link="base_link"/>
  <origin xyz="0 0 0.1005" rpy="0 0 3.14159"/>
</joint>
<link name="base_link">
  <inertial>
    <origin xyz="-3.244789018330238e-07 -0.0010765720842164906 0.07086414896629663" rpy="0 0 0"/>
    <mass value="104.19831248399346"/>
    <inertia ixx="0.994899" iyy="1.00618" izz="1.564619" ixy="-4e-06" iyz="-0.010142" ixz="-3e-06"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
    <geometry>
      <mesh filename="file://$(find agv_origin_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find agv_origin_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="lidar_1">
  <inertial>
    <origin xyz="6.625073916904315e-18 6.625073916904315e-18 0.010250000000000009" rpy="0 0 0"/>
    <mass value="0.6735333728409896"/>
    <inertia ixx="0.000248" iyy="0.000248" izz="0.000449" ixy="0.0" iyz="0.0" ixz="0.0"/>
