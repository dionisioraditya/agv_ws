<joint name="Rigid 1" type="fixed">
  <origin xyz="0.0 0.0 0.22" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="lidar_1"/>
</joint>

<joint name="Rigid 2" type="fixed">
  <origin xyz="0.0 -0.115 0.14" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="depth_cam_1"/>
</joint>

<joint name="Revolute 3" type="continuous">
  <origin xyz="0.1578 0.104 -0.0435" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="left_wheel_1"/>
  <axis xyz="-1.0 0.0 0.0"/>
</joint>

<joint name="Revolute 4" type="continuous">
  <origin xyz="-0.1578 0.104 -0.0435" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="right_wheel_1"/>
  <axis xyz="-1.0 0.0 0.0"/>
</joint>

<joint name="Revolute 5" type="continuous">
  <origin xyz="-0.12695 -0.1222 -0.0406" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="castrol_bracket_right_1"/>
  <axis xyz="0.0 0.0 -1.0"/>
</joint>

<joint name="Revolute 6" type="continuous">
  <origin xyz="0.017712 0.0342 -0.0344" rpy="0 0 0"/>
  <parent link="castrol_bracket_right_1"/>
  <child link="castrol_wheel_right_1"/>
  <axis xyz="-1.0 0.0 0.0"/>
</joint>

<joint name="Revolute 7" type="continuous">
  <origin xyz="0.12695 -0.1222 -0.0406" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="castrol_bracket_left_1"/>
  <axis xyz="0.0 0.0 -1.0"/>
</joint>

<joint name="Revolute 8" type="continuous">
  <origin xyz="-0.017712 0.0342 -0.0344" rpy="0 0 0"/>
  <parent link="castrol_bracket_left_1"/>
  <child link="castrol_wheel_left_1"/>
  <axis xyz="-1.0 0.0 0.0"/>
</joint>

<joint name="imu_joint" type="fixed">
  <origin xyz="0.0 0.0 0.1" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="imu_link"/>
</joint>

</robot>
