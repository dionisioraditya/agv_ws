  <visual>
    <origin xyz="-0.0 -0.0 -0.22" rpy="0 0 -1.5708"/>
    <geometry>
      <mesh filename="file://$(find agv_origin_description)/meshes/lidar_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="-0.0 -0.0 -0.22" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find agv_origin_description)/meshes/lidar_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="imu_link">
  <visual>
    <geometry>
      <box size="0.04 0.04 0.01"/>
    </geometry>
    <material name="silver"/>
  </visual>
</link>

